{
  "name": "amjaa-travels",
  "version": "1.0.0",
  "description": "Amja Tours (inbound) + Amja Travels (outbound) websites with one shared admin panel on Firebase",
  "main": "index.js",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "dev:inbound": "node scripts/sync-shared.mjs && serve inbound -l 5000",
    "dev:outbound": "node scripts/sync-shared.mjs && serve outbound -l 5001",
    "deploy": "node scripts/sync-shared.mjs && firebase deploy --only hosting,firestore:rules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "serve": "^14.2.6"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0"
  }
}