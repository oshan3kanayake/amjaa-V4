rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Firestore Security Rules — the whole "backend".
// One project serves BOTH websites (Amja Tours inbound + Amja Travels
// outbound) and the shared admin panel.
//
//   Website content (hotels, cars, planner, Hajj, Umrah, flights, settings)
//     • anyone may READ   (public websites)
//     • only ADMIN may WRITE
//   Enquiries (all forms on both sites)
//     • anyone may CREATE a valid enquiry
//     • only ADMIN may read / update / delete
//
// "Admin" = signed-in Firebase Auth user with custom claim admin:true
// (set once with scripts/set-admin-claim.js).
// ─────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isContent(col) {
      return col in [
        'hotels', 'fleet', 'expertCities',
        'hajj_packages', 'umrah_packages', 'flight_deals',
        // older collections from the first site, kept readable
        'tour_packages_inbound', 'tour_packages_outbound', 'flights', 'flight_destinations', 'international_hotels'
      ];
    }

    match /{col}/{docId} {
      allow read:  if isContent(col);
      allow write: if isContent(col) && isAdmin();
    }

    // Company & brand + planner rules
    match /settings/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Private admin settings (email keys)
    match /private/{id} {
      allow read, write: if isAdmin();
    }

    function validEnquiry() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() < 200
          && d.phone is string && d.phone.size() > 0 && d.phone.size() < 60
          && d.category is string && d.category.size() < 40
          && (!('site' in d) || d.site in ['inbound', 'outbound'])
          && (!('message' in d) || (d.message is string && d.message.size() < 5000))
          && d.read == false
          && d.handled == false;
    }

    match /enquiries/{id} {
      allow create: if validEnquiry();
      allow read, update, delete: if isAdmin();
    }
  }
}
